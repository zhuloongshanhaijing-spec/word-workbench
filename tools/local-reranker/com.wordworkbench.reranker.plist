<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wordworkbench.reranker</string>
    <!-- Template: replace __REPO_ROOT__ with this repository's absolute path
         before loading, e.g.
         sed "s|__REPO_ROOT__|$(pwd)|g" com.wordworkbench.reranker.plist > ~/Library/LaunchAgents/com.wordworkbench.reranker.plist -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__REPO_ROOT__/tools/local-reranker/serve.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/tmp/wwb-reranker-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/wwb-reranker-launchd.log</string>
</dict>
</plist>
